; Engine configuration file.
config_version=5

[application]

config/name="Arena"
config/description="Mine, craft, and survive a crumbling map. Last one standing wins."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

driver/output_latency.web=100

[display]

window/size/viewport_width=1200
window/size/viewport_height=744
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.027, 0.031, 0.059, 1)
